Issue: https://github.com/ocamllibs/stdcompat/issues/62
Original patch source: https://src.fedoraproject.org/rpms/ocaml-stdcompat/blob/rawhide/f/ocaml-stdcompat-ocaml5.4.patch

This patch makes the latest stdcompat release compatible with OCaml 5.4 in the sense that all existing compatibility shims will now compile. It does not backport OCaml 5.4 features to older compilers.

--- stdcompat-21.1/configure.ac.orig	2025-08-20 02:18:12.000000000 -0600
+++ stdcompat-21.1/configure.ac	2025-10-16 09:41:47.202271264 -0600
@@ -185,6 +185,8 @@ AC_WITH_OCAML_VERSION([5_0_0], [5.0.0])
 AC_WITH_OCAML_VERSION([5_1_0], [5.1.0])
 AC_WITH_OCAML_VERSION([5_2_0], [5.2.0])
 AC_WITH_OCAML_VERSION([5_3_0], [5.3.0])
+AC_WITH_OCAML_VERSION([5_4_0], [5.4.0])
+AC_WITH_OCAML_VERSION([5_4_1], [5.4.1])

 AS_IF([test "x$target_os_type" = "xWin32"],
   [AC_WITH_BLOCK([WIN32])],
