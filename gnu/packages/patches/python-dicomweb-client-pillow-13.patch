             with io.BytesIO() as fp:
                 image.save(fp, codec_name, **codec_kwargs)  # type: ignore
                 fp.seek(0)
@@ -3895,6 +3897,8 @@ class DICOMfileClient:
                 )
             )
             image = Image.fromarray(array)
