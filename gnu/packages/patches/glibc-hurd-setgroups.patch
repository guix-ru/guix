 hurd/seteuids.c | 4 ++--
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/hurd/hurd.h b/hurd/hurd.h
index 05674a93bb..3f1865c57b 100644
--- a/hurd/hurd.h
+++ b/hurd/hurd.h
@@ -177,7 +177,7 @@ extern int _hurd_change_directory_port_from_fd (struct hurd_port *portcell,
 
 /* Get and set the effective UID set.  */
 extern int geteuids (int __n, uid_t *__uidset);
-extern int seteuids (int __n, const uid_t *__uidset);
+extern int seteuids (size_t __n, const uid_t *__uidset);
 
 
 /* Split FILE into a directory and a name within the directory.  The
diff --git a/hurd/seteuids.c b/hurd/seteuids.c
index ea93e0c51e..3be772ae8b 100644
--- a/hurd/seteuids.c
+++ b/hurd/seteuids.c
@@ -20,11 +20,11 @@
 
 /* Set the uid set for the current user to UIDS (N of them).  */
 int
-seteuids (int n, const uid_t *uids)
+seteuids (size_t n, const uid_t *uids)
 {
   error_t err;
   auth_t newauth;
-  int i;
+  size_t i;
   gid_t new[n];
 
   /* Fault before taking locks.  */
